# Copy to .env.local for local development; use secure environment settings in cloud.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only values. Never prefix these names with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
ODDS_API_KEY=
# Generate a random value locally; use the same CRON_SECRET in Vercel settings.
CRON_SECRET=
